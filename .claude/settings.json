{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(./mvnw:*)",
      "Bash(cd zero-spring/backend && ./mvnw:*)",
      "Bash(npm run build)",
      "Bash(npm run test)",
      "Bash(npm run lint)",
      "Bash(npm run gen:api)",
      "Bash(npm ci)",
      "Bash(docker compose up -d)",
      "Bash(docker compose ps)",
      "Bash(docker compose logs:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(bash zero-spring/scripts/ci-local.sh:*)",
      "Bash(git push:*)",
      "Bash(docker compose down:*)"
    ],
    "ask": [],
    "deny": [
      "Read(./zero-spring/frontend/app/.env)",
      "Read(./zero-spring/frontend/app/.env.*)",
      "Read(**/*.pem)",
      "Read(**/*.p12)",
      "Bash(git push --force:*)",
      "Bash(git reset --hard:*)"
    ]
  }
}