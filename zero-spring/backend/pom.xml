<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.5</version>
        <relativePath/>
    </parent>

    <groupId>com.mycompanyname</groupId>
    <artifactId>zero-platform</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <name>zero-platform</name>
    <description>Zero Platform - multi-tenant startup backend template</description>

    <properties>
        <java.version>21</java.version>
        <spring-modulith.version>1.4.5</spring-modulith.version>
        <springdoc.version>2.8.5</springdoc.version>
        <logstash-logback-encoder.version>8.0</logstash-logback-encoder.version>
        <shedlock.version>5.16.0</shedlock.version>
        <bucket4j.version>8.10.1</bucket4j.version>
        <archunit.version>1.4.1</archunit.version>
        <stripe-java.version>33.1.1</stripe-java.version>
        <iyzipay-java.version>2.0.142</iyzipay-java.version>
        <totp.version>1.7.1</totp.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.modulith</groupId>
                <artifactId>spring-modulith-bom</artifactId>
                <version>${spring-modulith.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- Web / Security -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
        </dependency>

        <!-- Data / Validation / Ops -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-cache</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aop</artifactId>
        </dependency>

        <!-- Modulith -->
        <dependency>
            <groupId>org.springframework.modulith</groupId>
            <artifactId>spring-modulith-starter-core</artifactId>
        </dependency>

        <!-- F5 Slice B: distributed lock for the scheduled lifecycle job (K10) -->
        <dependency>
            <groupId>net.javacrumbs.shedlock</groupId>
            <artifactId>shedlock-spring</artifactId>
            <version>${shedlock.version}</version>
        </dependency>
        <dependency>
            <groupId>net.javacrumbs.shedlock</groupId>
            <artifactId>shedlock-provider-jdbc-template</artifactId>
            <version>${shedlock.version}</version>
        </dependency>

        <!-- F5-B PROD-R6: token-bucket rate limiting for the unauthenticated endpoints. -->
        <dependency>
            <groupId>com.bucket4j</groupId>
            <artifactId>bucket4j-core</artifactId>
            <version>${bucket4j.version}</version>
        </dependency>
        <!-- PROD-R6 (distributed): shared token buckets in Redis so N replicas behind a load
             balancer enforce ONE cluster-wide limit instead of N x capacity. This module carries
             LettuceBasedProxyManager (io.github.bucket4j.redis.lettuce.cas). Its lettuce/jedis/redisson
             dependencies are all declared `provided` in the bucket4j-redis POM, so none is transitive:
             the Lettuce client already on the classpath via spring-boot-starter-data-redis (managed
             version) is reused, no second Redis client stack is pulled in. bucket4j-core (compile) is
             the only transitive edge, and it matches the version above. See RateLimitRedisConfig /
             DistributedRateLimitStore; the store is a lazy, degrade-to-local swap of RateLimitFilter's
             bucket store, not a new request-path dependency (Redis down -> per-instance fallback). -->
        <dependency>
            <groupId>com.bucket4j</groupId>
            <artifactId>bucket4j-redis</artifactId>
            <version>${bucket4j.version}</version>
        </dependency>

        <!-- P2-A: Stripe billing. The SDK is used for two things only: OFFLINE webhook signature
             verification (Webhook.constructEvent — no network) and the thin checkout-session API
             call behind the BillingProvider SPI. Bean registration is conditional on
             zero.billing.stripe.enabled, so the dependency is inert on a fresh clone. -->
        <dependency>
            <groupId>com.stripe</groupId>
            <artifactId>stripe-java</artifactId>
            <version>${stripe-java.version}</version>
        </dependency>

        <!-- P2'-B: iyzico billing (github.com/iyzico/iyzipay-java). The SDK is used for the two
             LIVE API calls only — checkout-form initialize and the retrieve that is the
             authoritative payment confirmation (it builds the IYZWSv2 auth header). Webhook
             signature verification (X-IYZ-SIGNATURE-V3) is implemented in IyzicoBillingProvider
             itself, offline, so the tests exercise the real verification with dummy secrets.
             Bean registration is conditional on zero.billing.iyzico.enabled — inert on a fresh
             clone, same as Stripe/PayTR. -->
        <dependency>
            <groupId>com.iyzipay</groupId>
            <artifactId>iyzipay-java</artifactId>
            <version>${iyzipay-java.version}</version>
        </dependency>

        <!-- Phase 2: Mail / Templating / Excel / Password policy -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-mail</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-thymeleaf</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml</artifactId>
            <version>5.3.0</version>
        </dependency>
        <dependency>
            <groupId>org.passay</groupId>
            <artifactId>passay</artifactId>
            <version>1.6.4</version>
        </dependency>

        <!-- 2FA: RFC 6238 TOTP. Used for THREE things only, none of which touches ZXing:
             DefaultSecretGenerator (base32 secret, via commons-codec), QrData#getUri (the
             otpauth:// provisioning URI string, no image), and DefaultCodeVerifier (constant-time
             code comparison with an explicit time-step tolerance). The library's optional QR *image*
             writer (ZxingPngQrGenerator) is the ONLY class that needs com.google.zxing, and we never
             instantiate it — the frontend renders the QR from the otpauth URI. So the ZXing edges are
             excluded rather than pulled in dead, matching the dependency discipline the bucket4j-redis
             block documents. commons-codec stays (compile-scope, transitive) — SecretGenerator and the
             verifier both need its Base32. -->
        <dependency>
            <groupId>dev.samstevens.totp</groupId>
            <artifactId>totp</artifactId>
            <version>${totp.version}</version>
            <exclusions>
                <exclusion>
                    <groupId>com.google.zxing</groupId>
                    <artifactId>core</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>com.google.zxing</groupId>
                    <artifactId>javase</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- Database -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- API docs -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc.version}</version>
        </dependency>

        <!-- Observability -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>net.logstash.logback</groupId>
            <artifactId>logstash-logback-encoder</artifactId>
            <version>${logstash-logback-encoder.version}</version>
        </dependency>

        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.modulith</groupId>
            <artifactId>spring-modulith-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.icegreen</groupId>
            <artifactId>greenmail-junit5</artifactId>
            <version>2.1.12</version>
            <scope>test</scope>
        </dependency>
        <!-- Q-01: ArchUnit. Bu depo bir ŞABLON; şablondaki en tehlikeli kusur KOPYALANAN
             DESEN'dir. Tek tek düzeltmek yetmez, kural gerekir — bkz.
             src/test/java/com/mycompanyname/zero/architecture/ArchitectureRules.java.
             Sadece çekirdek (archunit-junit5 motoru DEĞİL): kurallar düz JUnit 5 @Test
             içinden çağrılıyor, böylece surefire test sayımı olağan kalıyor. -->
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit</artifactId>
            <version>${archunit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <!-- R-01b: jar adı artifactId'den TÜRETİLMEZ. Bu depo bir şablon; klonlayan
             artifactId'yi değiştirir ve `zero-platform-0.1.0-SNAPSHOT.jar` adı onunla
             birlikte kayar. O ad üç ayrı yerde (Dockerfile COPY, ci.yml, ci-local.sh)
             glob ile aranıyordu; artifactId değişince Docker build gürültülü şekilde,
             CI ise SESSİZCE (boş `JAR=`) bozuluyordu.
             Sabit `app.jar` bu bağı tamamen koparır — tüketiciler adı bilir, türetmez. -->
        <finalName>app</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <release>21</release>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <configuration>
                    <includes>
                        <include>**/*IT.java</include>
                    </includes>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!-- Phase 2: JaCoCo coverage (report only; does not break the build) -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.12</version>
                <executions>
                    <execution>
                        <id>jacoco-prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>jacoco-report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>jacoco-check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <haltOnFailure>false</haltOnFailure>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.00</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
